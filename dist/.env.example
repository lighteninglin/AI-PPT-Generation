# ══════════════════════════════════════════
# PPT-Web 环境配置
# 复制为 .env 后按需修改，然后启动容器
# ══════════════════════════════════════════

# ── LLM API 配置（必填）──
# OpenAI 兼容的大模型 API
LLM_API_KEY=sk-you...here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ── 弱模型模式（可选）──
# 设为 1 启用弱模型模式：精简提示词 + 后端自动修复SVG
# 适用于上下文 <128K 的模型（如 glm-4.7-flash、deepseek-v3-lite 等）
# 含 flash/mini/small/lite/7b/8b/14b 的模型名会自动检测
LLM_IS_WEAK=0

# ── 上下文长度限制（可选）──
# 模型最大上下文token数，0=不限（由API自行决定）
# 常见值: glm-4.7-flash=65536, deepseek-v4=131072, gpt-4o=128000
# 设置后会自动计算 max_tokens，防止超出上下文限制
LLM_MAX_CONTEXT=0

# ── 服务端口 ──
HOST_PORT=8000
