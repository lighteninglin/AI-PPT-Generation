# ══════════════════════════════════════════
# PPT-Web 环境配置
# 复制为 .env 后按需修改，然后启动容器
# ══════════════════════════════════════════

# ── LLM API 配置（必填）──
# OpenAI 兼容的大模型 API
LLM_API_KEY=sk-you...here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
# 内网 Qwen3.8-27B-FP8 示例（模型名含 qwen3.8 时自动套用 262144 上下文 / 128000 输出与思考参数）:
# LLM_MODEL=Qwen/Qwen3.8-27B-FP8

# ── 弱模型模式（可选）──
# 设为 1 启用弱模型模式：精简提示词 + 后端自动修复SVG
# 适用于上下文 <128K 的模型（如 glm-4.7-flash、deepseek-v3-lite 等）
# 含 flash/mini/small/lite/7b/8b/14b 的模型名会自动检测
LLM_IS_WEAK=0

# ── 上下文长度与输出限制（可选但强烈建议）──
# LLM_MAX_CONTEXT: 模型最大上下文token数，0=不限（由API自行决定）
#   常见值: glm-4.7-flash=65536, deepseek-v4=131072, gpt-4o=128000, 大模型=262144
# LLM_MAX_OUTPUT:  单次最大输出token数，0=使用场景默认值（Qwen3.8 未配置时自动 128000）
#   官方建议: Qwen3.8-27B-FP8 最终回答=131072，这里保守取 128000；gpt-4o=16384
# 注意: 这两个值必须按模型/推理后端真实能力填写。如果 LLM_MAX_CONTEXT 填得过小，
#       后端会压缩 max_tokens，导致 SVG 输出被截断（finish_reason=length）。
LLM_MAX_CONTEXT=0
LLM_MAX_OUTPUT=0

# ── Qwen3.8 思考控制（可选）──
# 前端“深度思考”勾选对应 enable_thinking；不勾选时客户端显式关闭思考。
# 思考深度: xhigh / medium / low（Qwen3.8 模板默认 xhigh，这里默认 medium 控耗时）
LLM_REASONING_EFFORT=medium
# 思考开关的透传方式:
#   chat_template = vLLM / SGLang（自部署默认）
#   top_level     = Qwen Cloud / 官方 API
#   both          = 两种都发（中间网关忽略未知字段时最稳）
LLM_THINKING_PARAM_STYLE=chat_template

# ── 服务端口 ──
HOST_PORT=8000
